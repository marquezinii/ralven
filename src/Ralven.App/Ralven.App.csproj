<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(RalvenWindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Ralven.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Ralven.ico</ApplicationIcon>
    <!--
      ApplicationHighDpiMode (a alternativa sugerida pelo aviso WFO0003) não
      tem efeito aqui: ela só é aplicada pelo Program.Main gerado pelo
      designer do WinForms (ApplicationConfiguration.Initialize()), e este
      projeto usa WinForms só para a bandeja do sistema — quem inicia é o
      App.xaml do WPF. A leitura efetiva de DPI da janela principal vem do
      HwndSource do WPF, que só respeita o dpiAwareness declarado no
      manifesto abaixo. Suprimido intencionalmente, não ignorado por engano.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Ralven</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RalvenPerformanceProbe)' == 'true'">
    <StartupObject>Program</StartupObject>
    <OutputType>Exe</OutputType>
    <OutputPath>../../artifacts/performance-probe/</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(RalvenPerformanceProbe)' == 'true'">
    <Compile Include="../../scripts/PerformanceProbe.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(RalvenStartupProbe)' == 'true'">
    <StartupObject>StartupProbe</StartupObject>
    <OutputType>Exe</OutputType>
    <OutputPath>../../artifacts/startup-probe/</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(RalvenStartupProbe)' == 'true'">
    <Compile Include="../../scripts/StartupProbe.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RalvenDialogProbe)' == 'true'">
    <StartupObject>DialogProbe</StartupObject>
    <OutputType>Exe</OutputType>
    <OutputPath>../../artifacts/dialog-probe/</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(RalvenDialogProbe)' == 'true'">
    <Compile Include="../../scripts/DialogProbe.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="WPF-UI" />
    <ProjectReference Include="../Ralven.Contracts/Ralven.Contracts.csproj" />
    <ProjectReference Include="../Ralven.Core/Ralven.Core.csproj" />
    <ProjectReference Include="../Ralven.Windows/Ralven.Windows.csproj" />
    <ProjectReference Include="../Ralven.UpdateRuntime/Ralven.UpdateRuntime.csproj" />
    <ProjectReference Include="../Ralven.Broker/Ralven.Broker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Ralven.png" />
    <Resource Include="Assets/FiveM.png" />
    <Resource Include="Assets/ReShade.png" />
    <Resource Include="Assets/RalvenAi.Black.png" />
    <Resource Include="Assets/RalvenAi.White.png" />
    <Resource Include="../../assets/brand/fonts/inter-4.1/InterVariable.ttf" Link="Assets/Fonts/InterVariable.ttf" />
    <Resource Include="../../assets/brand/fonts/inter-4.1/InterVariable-Italic.ttf" Link="Assets/Fonts/InterVariable-Italic.ttf" />
    <Resource Include="../../assets/brand/fonts/geist-1.1.0/GeistVariableVF.ttf" Link="Assets/Fonts/GeistVariableVF.ttf" />
    <EmbeddedResource Include="Resources/oauth-callback.html" LogicalName="Ralven.App.Resources.oauth-callback.html" />
    <EmbeddedResource Include="Assets/update-manifest-public-key.pem" />
    <EmbeddedResource Include="Assets/broker-integrity-public-key.pem" />
    <EmbeddedResource Include="../../localization/locales.json" Link="Resources/locales.json" LogicalName="Ralven.App.Resources.locales.json" />
    <None Update="Assets/ReShade.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Config/appsettings.json;Config/appsettings.Development.json;Config/appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Machine-local, git-ignored overlay (see RemoteServicesOptionsLoader) for
      values GitHub's push protection would otherwise reject in a commit, like
      the Google OAuth client secret. The glob matches nothing on a normal
      checkout, so it never fails the build when absent.
    -->
    <Content Include="Config/appsettings.*.local.json" Condition="Exists('Config')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyBroker" AfterTargets="Build">
    <MSBuild
      Projects="../Ralven.Broker/Ralven.Broker.csproj"
      Targets="GetBrokerOutputDirectory"
      BuildInParallel="$(BuildInParallel)"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_BrokerOutputDirectory" />
    </MSBuild>
    <Error Condition="'@(_BrokerOutputDirectory)' == ''" Text="Unable to resolve the Ralven.Broker build output." />
    <PropertyGroup>
      <_BrokerOutputDirectoryPath>@(_BrokerOutputDirectory)</_BrokerOutputDirectoryPath>
    </PropertyGroup>
    <ItemGroup>
      <BrokerFiles Include="$(_BrokerOutputDirectoryPath)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerFiles)" DestinationFiles="@(BrokerFiles->'$(OutDir)broker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
