<ui:FluentWindow x:Class="Ralven.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Ralven.App.Controls"
        xmlns:pages="clr-namespace:Ralven.App.Views.Pages"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:services="clr-namespace:Ralven.App.Services"
        mc:Ignorable="d"
        Title="{Binding [Brand.ProductName], Source={StaticResource LocalizedStrings}}"
        Icon="Assets/Ralven.png"
        Width="1160"
        Height="680"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="{x:Static services:WindowBackdropPolicy.Current}"
        ResizeMode="CanResize"
        FontFamily="{StaticResource AppFontBody}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource CanvasBaseBrush}">

    <!--
        =====================================================================
        DIREÇÃO VISUAL: Ralven
        =====================================================================
        TESE  Uma interface escura, precisa e serena, onde os números reais
              da máquina do usuário recebem prioridade visual.
              Recusa o padrão da categoria (laje de grafite + neon + medidor
              decorativo) e recusa a direção anterior (folha de papel técnico
              com moldura, retícula milimetrada e traço fino).

        MUNDO Carvão e grafite recebem um brilho branco sutil ancorado no
              canto inferior esquerdo — onde ficam o rail de navegação e a
              ação primária de cada página. Superfícies em prata fotográfica,
              cantos de 10–18px, Inter como voz da marca e o mono reservado
              a número medido. Cor aparece apenas quando comunica estado.

        FORMA A janela NÃO emoldura a página. Cabeçalho direto sobre o chão,
              conteúdo em painéis que se erguem por sombra e tom. Nenhum
              painel dentro de painel.
        =====================================================================
    -->

    <ui:FluentWindow.Resources>
        <ContextMenu x:Key="TrayContextMenu"
                     Style="{StaticResource TrayContextMenuStyle}"
                     Placement="MousePoint"
                     StaysOpen="False"
                     Opened="TrayMenu_Opened"
                     AutomationProperties.Name="{Binding [Tray.MenuName], Source={StaticResource LocalizedStrings}}">
            <MenuItem Style="{StaticResource TrayMenuHeaderStyle}">
                <MenuItem.Header>
                    <Grid Margin="12,8,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                Background="{StaticResource TrayMenuHoverBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                            <Image Source="Assets/Ralven.png"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Brand.ProductName], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource BodyStrongText}"
                                       Foreground="{StaticResource TrayMenuTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TrayMenuMutedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLiveAlertIconVisible}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFiveMSessionMonitoring}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource InfoBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFiveMSessionActive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUpdateBannerVisible}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource InfoBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource TrayMenuTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock MaxWidth="188"
                                           Foreground="{StaticResource TrayMenuMutedTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                            <Setter Property="Foreground" Value="{StaticResource TrayMenuMutedTextBrush}" />
                                            <Setter Property="Text" Value="{Binding [Tray.Status.Ready], Source={StaticResource LocalizedStrings}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLiveAlertIconVisible}" Value="True">
                                                    <Setter Property="Text" Value="{Binding LiveAlertMessage}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFiveMSessionMonitoring}" Value="True">
                                                    <Setter Property="Text" Value="{Binding FiveMSessionStatusLabel}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource InfoBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFiveMSessionActive}" Value="True">
                                                    <Setter Property="Text" Value="{Binding FiveMSessionStatusLabel}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsUpdateBannerVisible}" Value="True">
                                                    <Setter Property="Text" Value="{Binding UpdateBannerTitle}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource InfoBaseBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Text" Value="{Binding ProgressHeadline}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TrayMenuTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding AppVersion, StringFormat=v{0}}"
                                   Style="{StaticResource CaptionText}"
                                   Foreground="{StaticResource TrayMenuMutedTextBrush}"
                                   VerticalAlignment="Top" />
                    </Grid>
                </MenuItem.Header>
            </MenuItem>

            <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />

            <MenuItem Header="{Binding [Tray.Open], Source={StaticResource LocalizedStrings}}"
                      Style="{StaticResource TrayMenuItemStyle}"
                      Click="TrayOpen_Click"
                      AutomationProperties.Name="{Binding [Tray.Open], Source={StaticResource LocalizedStrings}}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource Icon20}"
                          Data="{StaticResource IconStartup}"
                          Stroke="{StaticResource TrayMenuMutedTextBrush}" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="{Binding [Tray.Optimize], Source={StaticResource LocalizedStrings}}"
                      Click="TrayOptimize_Click"
                      AutomationProperties.Name="{Binding [Tray.Optimize], Source={StaticResource LocalizedStrings}}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource Icon20}"
                          Data="{StaticResource IconBolt}"
                          Stroke="{StaticResource TrayMenuMutedTextBrush}" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TrayMenuItemStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWindowsGamingBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <MenuItem Header="{Binding FiveMSessionActionLabel}"
                      IsEnabled="{Binding CanToggleFiveMSessionMonitor}"
                      Click="TraySessionMonitor_Click"
                      AutomationProperties.Name="{Binding FiveMSessionActionLabel}"
                      AutomationProperties.HelpText="{Binding FiveMSessionDetailLabel}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource Icon20}"
                          Data="{StaticResource IconGame}"
                          Stroke="{StaticResource TrayMenuMutedTextBrush}" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TrayMenuItemStyle}">
                        <Setter Property="InputGestureText" Value="{Binding [Tray.SessionUnavailable], Source={StaticResource LocalizedStrings}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFiveMSessionMonitoring}" Value="True">
                                <Setter Property="InputGestureText" Value="{Binding FiveMSessionStatusLabel}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />

            <MenuItem InputGestureText="{Binding AvailableUpdateVersion}"
                      IsEnabled="{Binding CanCheckForUpdatesManually}"
                      Click="TrayCheckUpdates_Click"
                      AutomationProperties.Name="{Binding [Tray.CheckUpdates], Source={StaticResource LocalizedStrings}}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource Icon20}"
                          Data="{StaticResource IconRefresh}"
                          Stroke="{StaticResource TrayMenuMutedTextBrush}" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TrayMenuItemStyle}">
                        <Setter Property="Header" Value="{Binding [Tray.CheckUpdates], Source={StaticResource LocalizedStrings}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUpdateBannerVisible}" Value="True">
                                <Setter Property="Header" Value="{Binding UpdateBannerTitle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

            <MenuItem Header="{Binding [Tray.Settings], Source={StaticResource LocalizedStrings}}"
                      Style="{StaticResource TrayMenuItemStyle}"
                      Click="TraySettings_Click"
                      AutomationProperties.Name="{Binding [Tray.Settings], Source={StaticResource LocalizedStrings}}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource Icon20}"
                          Data="{StaticResource IconDefaults}"
                          Stroke="{StaticResource TrayMenuMutedTextBrush}" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator Style="{StaticResource TrayMenuSeparatorStyle}" />

            <MenuItem Header="{Binding [Tray.Exit], Source={StaticResource LocalizedStrings}}"
                      Click="TrayExit_Click"
                      AutomationProperties.Name="{Binding [Tray.Exit], Source={StaticResource LocalizedStrings}}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource Icon20}"
                          Data="{StaticResource IconClose}"
                          Stroke="{DynamicResource DangerBaseBrush}" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource TrayMenuItemStyle}">
                        <Setter Property="Tag" Value="Danger" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWindowsGamingBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource CanvasBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            A LUZ AMBIENTE. Um Rectangle atrás de tudo, pintado com um único
            RadialGradientBrush estático (a GPU o cacheia; não há animação e
            não há custo por quadro). É o gesto central da direção: sem ele o
            fundo volta a ser uma laje chapada.
            IsHitTestVisible=False para que ele nunca intercepte um clique.
        -->
        <Rectangle Grid.RowSpan="2" Fill="{DynamicResource AmbientLightBrush}" IsHitTestVisible="False" />

        <!-- ===================== Barra de título ===================== -->
        <!-- Background explícito, não Transparent: a janela usa backdrop Mica,
             e uma barra transparente deixa o Mica do SISTEMA aparecer — então
             a barra continuava escura com o app em tema claro, porque o
             Windows do usuário estava em escuro. Pintá-la com o mesmo chão da
             interface também faz a barra e o conteúdo lerem como uma peça só. -->
        <ui:TitleBar Grid.Row="0" Height="52" Background="{DynamicResource CanvasBaseBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Source="Assets/Ralven.png" Width="24" Height="24" Stretch="Uniform" />
                    <TextBlock Margin="11,0,0,0"
                               Text="{Binding [Brand.ProductName], Source={StaticResource LocalizedStrings}, Mode=OneWay}"
                               Style="{StaticResource BodyStrongText}"
                               VerticalAlignment="Center"
                               FontSize="15" />

                    <!--
                        Cluster de estado global. Substitui banners espalhados
                        pelas páginas: uma marca acesa por vez, sempre no mesmo
                        lugar. Ocupação (execução) tem precedência sobre update
                        e sobre aviso, porque é a única das três que descreve
                        algo acontecendo agora.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource CaptionText}" Foreground="{DynamicResource AccentTextBrush}" Margin="9,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding [Optimizer.Stage.Run], Source={StaticResource LocalizedStrings}, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ProgressPercentLabel, Mode=OneWay}" FontFamily="{StaticResource AppFontMono}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Style="{StaticResource LinkButtonStyle}" Padding="8,3" VerticalAlignment="Center" Visibility="{Binding IsUpdateAttentionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="ShowUpdateBanner_Click"
                                ToolTip="{Binding [Update.Reopen], Source={StaticResource LocalizedStrings}}"
                                AutomationProperties.Name="{Binding [Update.Reopen], Source={StaticResource LocalizedStrings}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource InfoBaseBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UpdateBannerTitle}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource InfoBaseBrush}" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsLiveAlertStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBaseBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LiveAlertMessage}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource WarningBaseBrush}" Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis" />
                            <Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0" Click="LiveAlertDismiss_Click"
                                    ToolTip="{Binding [LiveAlert.Dismiss], Source={StaticResource LocalizedStrings}}"
                                    AutomationProperties.Name="{Binding [LiveAlert.Dismiss], Source={StaticResource LocalizedStrings}}">
                                <Path Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.5" Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LiveAlertIconButton"
                            Style="{StaticResource IconButtonStyle}"
                            Visibility="{Binding IsLiveAlertIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Click="ShowLiveAlertNotification_Click"
                            ToolTip="{Binding [LiveAlert.Reopen], Source={StaticResource LocalizedStrings}}"
                            AutomationProperties.Name="{Binding [LiveAlert.Reopen], Source={StaticResource LocalizedStrings}}">
                        <Path Style="{StaticResource Icon20}" Data="{Binding LiveAlertIconKey, Converter={StaticResource GeometryKeyConverter}}" Stroke="{Binding LiveAlertToneBrushKey, Converter={StaticResource BrushKeyConverter}}" />
                    </Button>
                    <Button x:Name="DiscordButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Discord_Click"
                            ToolTip="{Binding [Discord.TitleBarTooltip], Source={StaticResource LocalizedStrings}}"
                            AutomationProperties.Name="{Binding [Discord.TitleBarTooltip], Source={StaticResource LocalizedStrings}}">
                        <Path Style="{StaticResource Icon20}" Data="{StaticResource IconDiscord}" Stroke="{x:Null}" Fill="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Border Style="{StaticResource VerticalHairlineDivider}" Height="22" Margin="8,0" VerticalAlignment="Center" />
                    <Button x:Name="AccountButton" Style="{StaticResource IconButtonStyle}" Width="Auto" Height="36" MinHeight="36" Padding="4,0,10,0" Click="Account_Click"
                            ToolTip="{Binding [Account.TitleBar.SignInPrompt], Source={StaticResource LocalizedStrings}}"
                            AutomationProperties.Name="{Binding [Account.TitleBar.SignInPrompt], Source={StaticResource LocalizedStrings}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusPill}">
                                <Grid>
                                    <ui:SymbolIcon x:Name="AccountFallbackIcon" Symbol="Person20" Width="20" Height="20" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse x:Name="AccountAvatarEllipse" Width="28" Height="28" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AccountLabel"
                                       Text="{Binding [Account.TitleBar.SignInPrompt], Source={StaticResource LocalizedStrings}}"
                                       Style="{StaticResource BodyStrongText}"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0"
                                       MaxWidth="200"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ===================== Navegação + conteúdo ===================== -->
        <ui:NavigationView x:Name="RootNavigationView"
                            Grid.Row="1"
                            IsBackButtonVisible="Collapsed"
                            PaneDisplayMode="Left"
                            OpenPaneLength="224"
                            CompactPaneLength="60"
                            Background="Transparent">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="DashboardNav" Content="{Binding [Navigation.Overview], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Home24}" Tag="Dashboard" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="RalvenAiNav" Content="{Binding [Navigation.RalvenAiDevelopment], Source={StaticResource LocalizedStrings}}" Tag="RalvenAi" Click="NavItem_Click">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="LockClosed24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="OptimizerNav" Content="{Binding [Navigation.Optimizer], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Rocket24}" Tag="Optimizer" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="SystemNav" Content="{Binding [Navigation.System], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon DesktopPulse24}" Tag="System" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="ApplicationsNav" Content="{Binding [Navigation.Applications], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Apps24}" Tag="Applications" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="GamesNav" Content="{Binding [Navigation.Games], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Games24}" Tag="Games" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="HistoryNav" Content="{Binding [Navigation.History], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon History24}" Tag="History" Click="NavItem_Click" />
                <ui:NavigationViewItem x:Name="SettingsNav" Content="{Binding [Navigation.Settings], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon Settings24}" Tag="Settings" Click="NavItem_Click" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="ProNav" Content="{Binding [Navigation.ProDevelopment], Source={StaticResource LocalizedStrings}}" Icon="{ui:SymbolIcon LockClosed24}" Tag="Pro" Click="NavItem_Click" />
                <ui:NavigationViewItem IsHitTestVisible="False"
                                       Focusable="False"
                                       IsTabStop="False"
                                       HorizontalContentAlignment="Stretch"
                                       AutomationProperties.Name="{Binding AboutVersionDeveloper}"
                                       Visibility="{Binding IsPaneOpen, ElementName=RootNavigationView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Content>
                        <Grid Margin="6,6,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Style="{StaticResource HeroAccentRule}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Sidebar.Version], Source={StaticResource LocalizedStrings}, Mode=OneWay}"
                                           Style="{StaticResource OverlineText}"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentWashBrush}"
                                        CornerRadius="{StaticResource RadiusXs}"
                                        Padding="8,3"
                                        Margin="10,0,0,0">
                                    <TextBlock Text="{Binding AppVersion, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongText}"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontFamily="{StaticResource AppFontMono}"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ui:NavigationViewItem.Content>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="PageContentHost">
                    <pages:OverviewPage x:Name="DashboardPage" />

                    <!-- ===================== Configurações ===================== -->
                    <!--
                        Configurações é uma superfície fixa: categorias
                        ancoradas à esquerda e formulário rolando à direita.

                        A coluna de "notas" de 400px que ficava aqui foi
                        removida. Ela repetia, sempre visível e independente
                        da categoria escolhida, o mesmo texto de privacidade
                        que a própria categoria Privacidade já traz — 400px de
                        largura gastos com uma cópia. O conteúdo real desceu
                        para dentro de Privacidade, onde alguém que abriu
                        Privacidade quer lê-lo.

                        A seção "Conta" permanece aqui (não em um arquivo de
                        página separado) porque MainWindow.Account.xaml.cs já é
                        o dono de accountService/profileService/avatarStore —
                        mover a marcação para outro x:Class quebraria esses
                        nomes de elemento.
                    -->
                    <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="{DynamicResource PanelFillBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CanvasSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14,28">
                            <StackPanel>
                                <TextBlock Text="{Binding [Settings.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="8,0,8,22" />
                                        <RadioButton x:Name="CategoryAccount" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Checked="SettingsCategory_Changed">
                                            <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                                        </RadioButton>
                                        <RadioButton x:Name="CategoryGeneral" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,4,0,0" Checked="SettingsCategory_Changed">
                                            <TextBlock Text="{Binding [Settings.General.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                                        </RadioButton>
                                        <RadioButton x:Name="CategoryPrivacy" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,4,0,0" Checked="SettingsCategory_Changed">
                                            <TextBlock Text="{Binding [Settings.Privacy.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                                        </RadioButton>
                                        <RadioButton x:Name="CategoryTools" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,4,0,0" Checked="SettingsCategory_Changed">
                                            <TextBlock Text="{Binding [Settings.Tools.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                                        </RadioButton>
                                        <RadioButton x:Name="CategoryAbout" GroupName="SettingsCategory" Style="{StaticResource SettingsCategoryItemStyle}" Margin="0,4,0,0" Checked="SettingsCategory_Changed">
                                            <TextBlock Text="{Binding [Settings.About.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyText}" />
                                        </RadioButton>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="SettingsContentScrollViewer" Grid.Column="1" Background="{DynamicResource PanelFillBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="48,36,48,40">
                            <StackPanel MaxWidth="920" HorizontalAlignment="Center">

                                <Border Style="{StaticResource AlertRowStyle}"
                                        Background="{DynamicResource DangerSurfaceBrush}"
                                        BorderBrush="{DynamicResource DangerBorderBrush}"
                                        Visibility="{Binding SettingsSaveErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SettingsSaveErrorMessage}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                                        <Button Grid.Column="1" Content="{Binding [Settings.SaveRetry], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="20,0,0,0" Click="RetrySaveSettings_Click" />
                                    </Grid>
                                </Border>

                                <!-- ===== Conta ===== -->
                                <StackPanel x:Name="AccountSettingsCard" Visibility="Collapsed">
                                    <StackPanel x:Name="AccountSettingsUnavailablePanel">
                                        <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                                        <TextBlock x:Name="AccountSettingsUnavailableText" Text="{Binding [Settings.Account.Unavailable], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                        <Button x:Name="AccountSettingsUnavailableRetryButton"
                                                Content="{Binding [Common.Retry], Source={StaticResource LocalizedStrings}}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Margin="0,20,0,0"
                                                Visibility="Collapsed"
                                                Click="RetryAccountReadinessFromSettings_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="AccountSettingsSignedOutPanel">
                                        <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                                        <Button Content="{Binding [Settings.Account.SignInButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,20,0,0" Click="OpenAccountFromSettings_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="AccountSettingsSignedInPanel" Visibility="Collapsed">
                                        <TextBlock Text="{Binding [Settings.Account.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,20" />

                                        <Border x:Name="AccountSettingsStatusPanel" Style="{StaticResource AlertRowStyle}" Visibility="Collapsed">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Path x:Name="AccountSettingsStatusIcon" Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <TextBlock Grid.Column="1" x:Name="AccountSettingsStatusText" Style="{StaticResource SecondaryText}" Margin="12,0,0,0" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="52" Height="52" CornerRadius="{StaticResource RadiusPill}">
                                                    <Grid>
                                                        <ui:SymbolIcon x:Name="AccountSettingsFallbackIcon" Symbol="Person32" Width="32" Height="32" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse x:Name="AccountSettingsAvatarEllipse" Width="52" Height="52" Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="AccountSettingsEmailText" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock x:Name="AccountSettingsUsernameText" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding [Settings.Account.PhotoLocalOnly], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="ChangePhotoButton" Content="{Binding [Settings.Account.ChangePhoto], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="ChangePhoto_Click" />
                                                    <Button x:Name="RemovePhotoButton" Content="{Binding [Settings.Account.RemovePhoto], Source={StaticResource LocalizedStrings}}" Style="{StaticResource LinkButtonStyle}" Margin="10,0,0,0" Visibility="Collapsed" Click="RemovePhoto_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{Binding [Settings.Account.Plan.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock x:Name="AccountEntitlementValueText"
                                                               Style="{StaticResource SecondaryText}"
                                                               Margin="0,4,0,0"
                                                               AutomationProperties.LiveSetting="Polite" />
                                                    <Expander Header="{Binding [Settings.Account.Plan.Details], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0">
                                                        <TextBlock x:Name="AccountEntitlementDetailText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                    </Expander>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="{Binding [Pro.DiscoverDevelopment], Source={StaticResource LocalizedStrings}}" Style="{StaticResource PrimaryButtonStyle}" Click="OpenPro_Click" Margin="0,0,0,8" />
                                                <Button
                                                        x:Name="AccountEntitlementRefreshButton"
                                                        Content="{Binding [Settings.Account.Plan.Refresh], Source={StaticResource LocalizedStrings}}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        Click="AccountEntitlementRefresh_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{Binding [Settings.Account.Discord.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock Text="{Binding [Settings.Account.Discord.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="DiscordLinkCodeText"
                                                               Visibility="Collapsed"
                                                               Margin="0,8,0,0"
                                                               FontFamily="Consolas"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               AutomationProperties.LiveSetting="Polite" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        x:Name="DiscordLinkButton"
                                                        Content="{Binding [Settings.Account.Discord.Generate], Source={StaticResource LocalizedStrings}}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Visibility="Collapsed"
                                                        VerticalAlignment="Center"
                                                        Click="DiscordLink_Click" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding [Settings.Account.Security.Title], Source={StaticResource LocalizedStrings}}"
                                                   Style="{StaticResource SubsectionText}"
                                                   Margin="0,28,0,11" />

                                        <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Settings.Account.PasswordLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock x:Name="AccountSettingsPasswordValue" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        x:Name="AccountSettingsPasswordButton"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        Click="AccountSettingsPassword_Click">
                                                    <Path Style="{StaticResource Icon16}" Data="{StaticResource IconEdit}" Stroke="{DynamicResource TextSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Settings.Account.GoogleLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock x:Name="AccountSettingsGoogleValue" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        x:Name="AccountSettingsGoogleButton"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        Click="AccountSettingsGoogle_Click" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Settings.Account.TwoFactorLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                    <TextBlock x:Name="AccountSettingsMfaValue" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        x:Name="AccountSettingsMfaButton"
                                                        Content="{Binding [Settings.Account.TwoFactorManage], Source={StaticResource LocalizedStrings}}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        Click="AccountSettingsMfa_Click" />
                                            </Grid>
                                        </Border>

                                        <Expander Header="{Binding [Settings.Account.Details.Title], Source={StaticResource LocalizedStrings}}" Margin="0,28,0,0">
                                            <StackPanel Margin="0,11,0,0">
                                                <Border x:Name="AccountSettingsCurrentPasswordPanel" Style="{StaticResource SettingRowStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [Settings.Account.CurrentPasswordLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                                                        <controls:RevealPasswordBox x:Name="AccountSettingsCurrentPasswordField" Placeholder="{Binding [Settings.Account.CurrentPasswordPlaceholder], Source={StaticResource LocalizedStrings}}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border x:Name="AccountSettingsCurrentMfaPanel" Style="{StaticResource SettingRowStyle}" Visibility="Collapsed">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding [TwoFactor.CurrentCodeLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBox x:Name="AccountSettingsCurrentMfaCodeBox"
                                                                 Style="{StaticResource FormTextBoxStyle}"
                                                                 MaxLength="6"
                                                                 InputMethod.IsInputMethodEnabled="False"
                                                                 AutomationProperties.Name="{Binding [TwoFactor.CurrentCodeLabel], Source={StaticResource LocalizedStrings}}" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock x:Name="AccountSettingsPasswordRequiredHint"
                                                           Text="{Binding [Settings.Account.PasswordRequiredForSensitiveActions], Source={StaticResource LocalizedStrings}}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="2,0,0,13"
                                                           TextWrapping="Wrap"
                                                           Visibility="Collapsed" />

                                                <Border Style="{StaticResource SettingRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding [Settings.Account.NewEmailLabel], Source={StaticResource LocalizedStrings}}" Style="{StaticResource FieldLabelStyle}" />
                                                            <TextBox x:Name="AccountSettingsNewEmailBox" Style="{StaticResource FormTextBoxStyle}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" x:Name="AccountSettingsChangeEmailButton" Content="{Binding [Settings.Account.ChangeEmail], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="16,23,0,0" Click="AccountSettingsChangeEmail_Click" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource SettingRowStyle}" BorderThickness="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Button x:Name="AccountSettingsLogoutButton" Content="{Binding [Settings.Account.SignOut], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="AccountSettingsLogout_Click" />
                                                        <Button Grid.Column="1" x:Name="AccountSettingsDeleteAccountButton" Content="{Binding [Settings.Account.Delete], Source={StaticResource LocalizedStrings}}" Style="{StaticResource DangerGhostButtonStyle}" Click="AccountSettingsDeleteAccount_Click" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== Geral ===== -->
                                <StackPanel x:Name="GeneralSettingsPanel">
                                    <TextBlock Text="{Binding [Settings.General.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" />
                                    <TextBlock Text="{Binding [Settings.General.Interface], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" Margin="0,20,0,10" />

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [Settings.Language.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.Language.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ComboBox x:Name="LanguageSelector" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsComboBoxStyle}" SelectionChanged="LanguageSelector_SelectionChanged"
                                                      AutomationProperties.Name="{Binding [Settings.Language.Title], Source={StaticResource LocalizedStrings}}"
                                                      AutomationProperties.HelpText="{Binding [Settings.Language.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [Settings.Appearance.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.Appearance.MotionSystem], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource SegmentedHostStyle}" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ThemeSystemOption" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="{Binding [Settings.Appearance.System], Source={StaticResource LocalizedStrings}}" Checked="SystemTheme_Checked" />
                                                    <RadioButton x:Name="ThemeDarkOption" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="{Binding [Settings.Appearance.Dark], Source={StaticResource LocalizedStrings}}" Checked="DarkTheme_Checked" />
                                                    <RadioButton x:Name="ThemeLightOption" GroupName="Theme" Style="{StaticResource SegmentedOptionStyle}" Content="{Binding [Settings.Appearance.Light], Source={StaticResource LocalizedStrings}}" Checked="LightTheme_Checked" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding [Settings.General.Startup], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" Margin="0,18,0,10" />

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Settings.StartWithWindows.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LaunchAtStartup}" AutomationProperties.Name="{Binding [Settings.StartWithWindows.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.StartWithWindows.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}" IsEnabled="{Binding LaunchAtStartup}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Settings.StartMinimized.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartMinimized}" AutomationProperties.Name="{Binding [Settings.StartMinimized.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.StartMinimized.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Settings.CloseBehavior.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}" AutomationProperties.Name="{Binding [Settings.CloseBehavior.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.CloseBehavior.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding [Settings.General.Updates], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" Margin="0,18,0,10" />

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Settings.AutomaticUpdates.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="{Binding [Settings.AutomaticUpdates.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.AutomaticUpdates.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}" IsEnabled="{Binding CheckForUpdates}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding [Settings.UpdateNotifications.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding NotifyWhenUpdateAvailable}" AutomationProperties.Name="{Binding [Settings.UpdateNotifications.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.UpdateNotifications.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [Settings.CheckForUpdates.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.CheckForUpdates.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ManualUpdateCheckMessage}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0" Visibility="{Binding ManualUpdateCheckMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding [Settings.CheckForUpdates.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanCheckForUpdatesManually}" Click="CheckForUpdatesManually_Click" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="{Binding [Settings.RestoreDefaults.Section], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" Margin="0,18,0,10" />

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [Settings.RestoreDefaults.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.RestoreDefaults.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding [Settings.RestoreDefaults.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreGeneralDefaults_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Privacidade ===== -->
                                <!--
                                    O detalhamento do que é e do que não é
                                    coletado desceu da antiga coluna lateral
                                    para cá. Ele estava visível o tempo todo,
                                    em todas as categorias; agora aparece uma
                                    vez, exatamente onde alguém foi procurá-lo.
                                -->
                                <StackPanel x:Name="PrivacySettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [Settings.Privacy.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,20" />
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [PrivacyConsent.Essential.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [PrivacyConsent.Essential.Summary], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <Expander Header="{Binding [Settings.Privacy.DataDetails], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding [PrivacyConsent.Essential.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                </Expander>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding [PrivacyConsent.Essential.Status], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Foreground="{DynamicResource SuccessBaseBrush}" VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [Settings.Telemetry.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.Telemetry.Summary], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <Expander Header="{Binding [Settings.Privacy.DataDetails], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding [Settings.Telemetry.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                </Expander>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ShareOptionalReports}" AutomationProperties.Name="{Binding [Settings.Telemetry.Title], Source={StaticResource LocalizedStrings}}" AutomationProperties.HelpText="{Binding [Settings.Telemetry.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>

                                    <Expander Header="{Binding [Settings.Privacy.ReportContents], Source={StaticResource LocalizedStrings}}" Margin="0,18,0,0">
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource FieldSurface}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Privacy.Collects.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Foreground="{DynamicResource SuccessBaseBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding [Privacy.Collects.Items], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource FieldSurface}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource OverlineText}" Foreground="{DynamicResource DangerBaseBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding [Privacy.DoesNotCollect.Items], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Expander>
                                </StackPanel>

                                <!-- ===== Ferramentas ===== -->
                                <StackPanel x:Name="ToolsSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [Settings.Tools.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,20" />
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [Settings.Cache.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.Cache.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding CacheStorageLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding [Settings.Cache.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanClearRalvenCache}" Click="ClearRalvenCache_Click"
                                                    AutomationProperties.Name="{Binding [Settings.Cache.Button], Source={StaticResource LocalizedStrings}}"
                                                    AutomationProperties.HelpText="{Binding [Settings.Cache.Description], Source={StaticResource LocalizedStrings}}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [GtaVBenchmark.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [GtaVBenchmark.Summary], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <Expander Header="{Binding [GtaVBenchmark.Details], Source={StaticResource LocalizedStrings}}" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding [GtaVBenchmark.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                                </Expander>
                                                <TextBlock Text="{Binding GtaVBenchmarkStatusLabel}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0" Visibility="{Binding GtaVBenchmarkStatusLabel, Converter={StaticResource StringToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding [GtaVBenchmark.RunButton], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanRunGtaVBenchmark}" Click="RunGtaVBenchmark_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [Settings.Tools.ReportIssue.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding [Settings.Tools.ReportIssue.Button], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="ReportBug_Click" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{Binding [Settings.About.Discord.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource BodyStrongText}" />
                                                <TextBlock Text="{Binding [Settings.About.Discord.Detail], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding [Settings.About.Discord.Action], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="Discord_Click" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Sobre ===== -->
                                <StackPanel x:Name="AboutSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [Settings.About.Title], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SectionText}" Margin="0,0,0,20" />
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/Ralven.png" Width="44" Height="44" Stretch="Uniform" VerticalAlignment="Top" />
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Settings.About.AppName], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SubsectionText}" />
                                            <TextBlock Text="{Binding AboutVersionDeveloper}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [Settings.About.Tagline], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,20,0,0" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />

                                    <Border Style="{StaticResource HairlineDivider}" Margin="0,20" />

                                    <Expander Header="{Binding [Safety.Limits.Title], Source={StaticResource LocalizedStrings}}">
                                        <TextBlock Text="{Binding [Safety.Limits.Description], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
                                    </Expander>

                                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                        <Button Content="{Binding [Settings.About.Repository], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Click="OpenRepository_Click" />
                                        <Button Content="{Binding [Settings.About.Changelog], Source={StaticResource LocalizedStrings}}" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Click="OpenChangelog_Click" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding [Brand.FooterCopyright], Source={StaticResource LocalizedStrings}}" Style="{StaticResource CaptionText}" Margin="0,24,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="392"
                            Margin="0,18,24,0"
                            Padding="16"
                            Panel.ZIndex="20"
                            Background="{Binding LiveAlertSurfaceBrushKey, Converter={StaticResource BrushKeyConverter}}"
                            BorderBrush="{Binding LiveAlertBorderBrushKey, Converter={StaticResource BrushKeyConverter}}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Effect="{DynamicResource Elevation2Shadow}"
                            Visibility="{Binding IsLiveAlertNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{Binding LiveAlertTitle}"
                            AutomationProperties.HelpText="{Binding LiveAlertMessage}"
                            automation:AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource Surface1Brush}" VerticalAlignment="Top">
                                <Path Style="{StaticResource Icon20}" Data="{Binding LiveAlertIconKey, Converter={StaticResource GeometryKeyConverter}}" Stroke="{Binding LiveAlertToneBrushKey, Converter={StaticResource BrushKeyConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                <TextBlock Text="{Binding LiveAlertTitle}" Style="{StaticResource BodyStrongText}" Foreground="{Binding LiveAlertToneBrushKey, Converter={StaticResource BrushKeyConverter}}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LiveAlertMessage}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" VerticalAlignment="Top" Click="LiveAlertDismiss_Click"
                                    ToolTip="{Binding [LiveAlert.Dismiss], Source={StaticResource LocalizedStrings}}"
                                    AutomationProperties.Name="{Binding [LiveAlert.Dismiss], Source={StaticResource LocalizedStrings}}">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
